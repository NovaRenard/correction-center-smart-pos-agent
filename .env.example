AGENT_ID=replace-with-stable-agent-uuid
AGENT_NAME=Reception Smart POS
AGENT_VERSION=0.1.0
CRM_WS_URL=wss://crm.example.kz/api/v1/smart-pos/agent/ws
# Set once for initial setup; it is migrated to Windows Credential Manager when possible.
CRM_AGENT_TOKEN=

SMART_POS_HOST=192.168.1.100
SMART_POS_PORT=8080
SMART_POS_CLIENT_NAME=KoshakanSmartPosAgent
SMART_POS_TLS_MODE=ip_insecure
SMART_POS_CA_BUNDLE=
SMART_POS_REQUEST_TIMEOUT_SECONDS=15

HEARTBEAT_INTERVAL_SECONDS=15
CRM_RECONNECT_MIN_SECONDS=1
CRM_RECONNECT_MAX_SECONDS=60
STATUS_POLL_INTERVAL_SECONDS=1
ACTUALIZE_INTERVAL_SECONDS=10
UNKNOWN_ACTUALIZE_TIMEOUT_SECONDS=180
DATA_DIRECTORY=.data
LOG_LEVEL=INFO
DEVELOPMENT_MODE=false
